# ──── Sepiida Server Dockerfile ────
FROM golang:1.25-alpine AS builder

WORKDIR /build

# 国内网络访问 proxy.golang.org 不通，使用腾讯云镜像
ENV GOPROXY=https://mirrors.tencent.com/go/,direct

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o sepiida-server ./cmd/server

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

ENV TZ=Asia/Shanghai
RUN adduser -D -u 1000 sepiida

COPY --from=builder /build/sepiida-server /app/sepiida-server

# Create keys directory
RUN mkdir -p /etc/sepiida/keys && chown sepiida /etc/sepiida/keys

USER sepiida
WORKDIR /app

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q --spider http://localhost:9090/health || exit 1

ENTRYPOINT ["/app/sepiida-server"]

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Full connection URL to an external Postgres instance.
# Example: postgres://user:password@host:5432/sepiida?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sepiida?sslmode=disable

# ── Server ────────────────────────────────────────────────────────────────
# Host port to expose the server on
SERVER_PORT=9090

# ── Agent ─────────────────────────────────────────────────────────────────
# API key used by the agent to authenticate with the server.
# Must match one of the keys in agent-keys.txt.
SEPIIDA_AGENT_KEY=agent-key-001

# Unique identifier for this agent instance.
SEPIIDA_AGENT_ID=agent-001

# Poll interval in seconds (how often the agent scans for workflow changes).
SEPIIDA_AGENT_INTERVAL=60

# Comma-separated paths inside the container the agent watches.
# Each path should contain UUID-named subdirectories with MiniWDL outputs.
SEPIIDA_WATCH_DIRS=/data/output

# Host directory to bind-mount as the watch directory.
# Create this directory and place UUID workflow folders inside it.
SEPIIDA_WATCH_HOST_DIR=./output

# ── Optional: Archive ────────────────────────────────────────────────────
# Uncomment and set to archive completed workflows.
# SEPIIDA_AGENT_ARCHIVE=-archive=s3://my-bucket
# SEPIIDA_AGENT_ARCHIVE_KEY_ID=...
# SEPIIDA_AGENT_ARCHIVE_KEY_SECRET=...
# SEPIIDA_ARCHIVE_HOST_DIR=./archive

# Sepiida standalone development configuration.
# Production deployments use Squid/deploy or Octopus/deploy.

DATABASE_URL=postgres://sepiida:change-me@localhost:5432/sepiida?sslmode=disable
SERVER_PORT=9090
SEPIIDA_KEY_REFRESH_SECONDS=30

# Server authentication: static for local/self-hosted, task-token for SaaS.
SEPIIDA_AUTH_MODE=static
SEPIIDA_AGENT_KEY_FILE=./agent-keys.txt
SEPIIDA_QUERY_KEY_FILE=./query-keys.txt
SEPIIDA_TASK_TOKEN_SECRET=

# Standalone Agent.
SEPIIDA_SERVER_URL=http://localhost:9090
SEPIIDA_AGENT_KEY=change-me-agent-key
SEPIIDA_AGENT_ID=local-agent
SEPIIDA_AGENT_INTERVAL=60
SEPIIDA_WATCH_DIRS=./output
SEPIIDA_ARCHIVE_URL=
SEPIIDA_ARCHIVE_KEY_ID=
SEPIIDA_ARCHIVE_KEY_SECRET=
SEPIIDA_ARCHIVE_TIMEOUT=30m

# Sepiida environment
# Copy to .env and replace secrets before production use.

# PostgreSQL
# Use a database/schema dedicated to Sepiida. Do not share the same schema with Squid.
DATABASE_URL=postgres://sepiida:change-me@postgres:5432/sepiida?sslmode=disable

# Server
SERVER_PORT=9090
SEPIIDA_KEY_REFRESH_SECONDS=30
# Must match Squid SEPIIDA_TASK_TOKEN_SECRET when using CVM per-task Agent tokens.
# Server and Agent reject configured task-token secrets shorter than 32 characters.
# Generate a unique production value, for example:
#   openssl rand -base64 48
# Leaving this blank makes token-based deployments fail fast until configured.
SEPIIDA_TASK_TOKEN_SECRET=
SEPIIDA_ALLOW_STATIC_AGENT_KEY=false

# Query key file mounted by docker-compose. Static agent key files are optional
# and only needed for legacy/local writes when SEPIIDA_ALLOW_STATIC_AGENT_KEY=true.
# Singular names are consumed directly by the binaries; plural names are kept
# for compose mount compatibility.
SEPIIDA_AGENT_KEY_FILE=./agent-keys.txt
SEPIIDA_QUERY_KEY_FILE=./query-keys.txt
SEPIIDA_AGENT_KEYS_FILE=./agent-keys.txt
SEPIIDA_QUERY_KEYS_FILE=./query-keys.txt

# Agent
# Local all-in-one agent key. CVM production should use Squid-signed per-task tokens instead.
# If used directly, this must match one key in agent-keys.txt.
SEPIIDA_AGENT_KEY=change-me-agent-key
# Prefer a Squid-issued per-task token for production agents. Avoid exposing
# SEPIIDA_TASK_TOKEN_SECRET to worker hosts unless this is a trusted legacy/local deployment.
SEPIIDA_TASK_TOKEN=
# Optional legacy/local override: when set, docker-compose passes this value to
# the Agent as SEPIIDA_TASK_TOKEN_SECRET for local signing.
SEPIIDA_AGENT_TASK_TOKEN_SECRET=
SEPIIDA_AGENT_ID=cvm-agent-001
SEPIIDA_AGENT_INTERVAL=60

# Comma-separated paths inside the container that contain UUID workflow dirs.
SEPIIDA_WATCH_DIRS=/data/output
# Host path must be writable by the Agent because .sepiida.json state is stored
# under each UUID directory to prevent repeated pushes/archives.
SEPIIDA_WATCH_HOST_DIR=./output

# Archive
# Leave SEPIIDA_ARCHIVE_URL empty to disable archive in local all-in-one compose.
# CVM production usually passes these args from Squid bootstrap instead.
# Tencent COS example: cos://ap-guangzhou/schema-bio-1250000000/archive/org-uuid
SEPIIDA_ARCHIVE_URL=
SEPIIDA_ARCHIVE_KEY_ID=
SEPIIDA_ARCHIVE_KEY_SECRET=
SEPIIDA_ARCHIVE_TIMEOUT=30m

# Alternative provider env vars used by the archiver when key flags are empty.
COS_SECRET_ID=
COS_SECRET_KEY=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Local archive mount for local-path archives.
SEPIIDA_ARCHIVE_HOST_DIR=./archive

# ──── Sepiida Agent Dockerfile ────
FROM golang:1.25-alpine AS builder

WORKDIR /build

# 国内网络访问 proxy.golang.org 不通，使用腾讯云镜像
ENV GOPROXY=https://mirrors.tencent.com/go/,direct

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o sepiida-agent ./cmd/agent

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai
RUN adduser -D -u 1001 sepiida

COPY --from=builder /build/sepiida-agent /app/sepiida-agent

USER sepiida
WORKDIR /app

ENTRYPOINT ["/app/sepiida-agent"]
